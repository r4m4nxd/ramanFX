// RamanFX ZoneVision for TradingView (Pine Script v6)
// Everything the MT4 ZoneBot thinks, minus placing orders: zones by your mentor's rules, A/B/C grade with the
// RamanFX Planner points, Sam Seiden odds-enhancer checklist, ranked potential trades with entry / stop / target,
// liquidity traps, trendlines and HTF bias (1m up to 12M).
// Add to chart: Pine Editor -> paste -> Save -> Add to chart. Alerts: Create alert -> "Any alert() function call".
//@version=6
indicator("RamanFX ZoneVision", shorttitle="ZoneVision", overlay=true, max_boxes_count=200, max_lines_count=100, max_labels_count=100, max_bars_back=2100)

// ---------- inputs ----------
gR = "Zone rules (keep equal to ZoneBot)"
legRatio   = input.float(1.5, "Move-away range / largest base candle", minval=1.0, step=0.1, group=gR)
maxBase    = input.int(6, "Max basing candles", minval=1, maxval=6, group=gR)
maxZoneATR = input.float(1.5, "Max zone height (x ATR14)", minval=0.2, step=0.1, group=gR)
minDep     = input.float(1.5, "Departure: price must leave >= N x zone height", minval=0.0, step=0.1, group=gR)
lookback   = input.int(300, "Ignore zones older than (bars)", minval=50, maxval=2000, group=gR)
swingN     = input.int(3, "Swing strength for liquidity-trap levels (bars each side)", minval=1, maxval=10, group=gR)
tlSwing    = input.int(2, "Trendlines: swing = N bars each side; real only after a new higher high / lower low", minval=1, maxval=10, group=gR)
trapATR    = input.float(1.0, "Liquidity trap: level within N x ATR in front of the zone", step=0.1, group=gR)
minRR      = input.float(2.0, "Min reward:risk for the plan", step=0.1, group=gR)
onlyChain  = input.bool(true, "Sunday rule: trade only zones in the chain (removed opp. zone or made a new all-time high/low)", group=gR)
minGap     = input.float(0.15, "Space under the stay-away candle (x zone height): below = drawable only", minval=0, step=0.05, group=gR)
minSizeMed = input.float(0.5, "Zone smaller than N x the median zone = too small", minval=0, step=0.1, group=gR)
emoATR     = input.float(3.0, "Emotional candle (range > N x ATR): its wick is ignored for removal", minval=1, step=0.5, group=gR)
metalStop  = input.float(2.0, "Stop buffer multiplier on gold / silver / oil", minval=1, step=0.5, group=gR)
htfIn      = input.timeframe("", "HTF (empty = auto: 1m>15m, 5m>1H, 15m>4H, 1H>D, 4H>W, D>M, W>3M, M and up>12M)", group=gR)

gS = "What to show (clean by default)"
nShow       = input.int(4, "Zones drawn: the N closest to price", minval=1, maxval=20, group=gS)
showTested  = input.bool(false, "Also draw tested zones", group=gS)
showRemoved = input.bool(false, "Also draw removed zones (faint)", group=gS)
showNames   = input.bool(true, "Zone name + grade in the box", group=gS)
showTrap    = input.bool(true, "Liquidity traps (purple)", group=gS)
showEmo     = input.bool(true, "Mark emotional candles (range > N x ATR, see Zone rules) with a star", group=gS)
showTL      = input.bool(true, "Draw trendlines", group=gS)
showUpTL    = input.bool(true, "  Rising trendline (higher lows)", group=gS)
showDnTL    = input.bool(true, "  Falling trendline (lower highs)", group=gS)
tlHist      = input.int(3, "  Trendlines drawn each way (newest N; broken ones end where they broke)", minval=1, maxval=10, group=gS)
showChan    = input.bool(false, "  Draw the channel 50% helper line (the overextended check works either way)", group=gS)
showHtfTL   = input.bool(true, "  Also draw the HTF trendlines on this chart (precision on the entry timeframe)", group=gS)
refineHtf   = input.bool(true, "  Re-anchor HTF lines on this chart's candles (exact top-most / bottom-most touch)", group=gS)
cHtfTL      = input.color(color.new(#E8B04A, 15), "  HTF trendline colour", group=gS)
showPlan    = input.bool(true, "Potential trades (entry / stop / target)", group=gS)
nTrades     = input.int(3, "  How many potential trades to list", minval=1, maxval=5, group=gS)
planLines   = input.string("Best only", "  Draw entry/stop/target lines for", options=["Best only", "All listed"], group=gS)
gradeF      = input.string("All", "  Grades to show", options=["All", "A only", "A + B", "B only", "C only"], group=gS)
showCounter = input.bool(false, "  Also list counter-trend setups", group=gS)
maxDist     = input.float(6.0, "  Ignore zones beyond N x HTF ATR (0 = any)", minval=0, step=0.5, group=gS)
liveATR     = input.float(2.0, "  Within reach: zone <= N x HTF ATR away (further = FAR: planned, halfway alert)", minval=0.5, step=0.5, group=gS)
showWhy     = input.bool(true, "  Explain the best trade (odds checklist)", group=gS)
showPanel   = input.bool(true, "Info panel", group=gS)
panelView   = input.string("Full", "Panel view (Pine has no buttons: switch here)", options=["Full", "Compact", "Header only"], group=gS)
panelPos    = input.string("Top right", "Panel position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gS)
panelSizeS  = input.string("Small", "Panel text size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=gS)
panelSize   = panelSizeS == "Tiny" ? size.tiny : panelSizeS == "Normal" ? size.normal : panelSizeS == "Large" ? size.large : panelSizeS == "Huge" ? size.huge : size.small
panelWhere  = panelPos == "Top left" ? position.top_left : panelPos == "Bottom right" ? position.bottom_right : panelPos == "Bottom left" ? position.bottom_left : position.top_right
labelGap    = input.float(3.0, "Label spacing (% of recent range): closer price tags are merged", minval=0.5, maxval=10, step=0.5, group=gS)
doAlerts    = input.bool(true, "Alert when price reaches a fresh zone with the HTF trend", group=gS)

gC = "Colours"
cDemF = input.color(color.new(#5FD08A, 85), "Demand fill", group=gC)
cDemL = input.color(color.new(#7EE0A0, 30), "Demand line", group=gC)
cSupF = input.color(color.new(#FF8A7A, 85), "Supply fill", group=gC)
cSupL = input.color(color.new(#FF9E8F, 30), "Supply line", group=gC)
cTrap = input.color(color.new(#C7B6FF, 20), "Liquidity trap", group=gC)
cRem  = input.color(color.new(#FFB4A0, 92), "Removed zone", group=gC)
cTL   = input.color(color.new(#D0D4DC, 40), "Trendline", group=gC)
cTxt  = input.color(#C9CED8, "Text", group=gC)
cEntry = input.color(#7FB2FF, "Plan entry", group=gC)
cStop  = input.color(#FF8C8C, "Plan stop", group=gC)
cTgt   = input.color(#7EE0A0, "Plan target", group=gC)

// ---------- helpers ----------
atr = ta.atr(14)
// emotional candle: usually news or a stop run; its wick does not remove a zone, only a body close beyond the distal does
emo = showEmo and barstate.isconfirmed and high - low > emoATR * atr[1]
plotshape(emo and close >= open, "Emotional candle (up)", shape.diamond, location.abovebar, color.new(#E8C46A, 10), size=size.tiny, text="emo", textcolor=color.new(#E8C46A, 10))
plotshape(emo and close < open, "Emotional candle (down)", shape.diamond, location.belowbar, color.new(#E8C46A, 10), size=size.tiny, text="emo", textcolor=color.new(#E8C46A, 10))
rng(i) => high[i] - low[i]
bod(i) => math.abs(close[i] - open[i])
basing(i) => rng(i) > 0 and bod(i) <= 0.5 * rng(i)
cdir(i) => close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0

tfs = timeframe.in_seconds()
autoHtf = tfs <= 60 ? "15" : tfs <= 300 ? "60" : tfs <= 900 ? "240" : tfs <= 3600 ? "D" : tfs <= 14400 ? "W" : tfs <= 86400 ? "M" : tfs <= 604800 ? "3M" : "12M"
htf = htfIn == "" ? autoHtf : htfIn
// stop buffer in pips by timeframe (same as ZoneBot)
bufPips = tfs <= 60 ? 1.0 : tfs <= 300 ? 1.5 : tfs <= 900 ? 3.0 : tfs <= 3600 ? 5.0 : tfs <= 14400 ? 10.0 : tfs <= 86400 ? 20.0 : tfs <= 604800 ? 40.0 : tfs <= 2700000 ? 80.0 : 150.0
symU = str.upper(syminfo.ticker)
metalOil = str.contains(symU, "XAU") or str.contains(symU, "GOLD") or str.contains(symU, "XAG") or str.contains(symU, "OIL") or str.contains(symU, "WTI") or str.contains(symU, "BRENT") or str.contains(symU, "XTI") or str.contains(symU, "XBR")
allHi = ta.max(high)
allLo = ta.min(low)
pip = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)

// HTF trend: higher highs + higher lows = up, lower highs + lower lows = down, else last break of structure
f_trend() =>
    ph = ta.pivothigh(2, 2)
    pl = ta.pivotlow(2, 2)
    h1 = ta.valuewhen(not na(ph), ph, 0)
    h2 = ta.valuewhen(not na(ph), ph, 1)
    l1 = ta.valuewhen(not na(pl), pl, 0)
    l2 = ta.valuewhen(not na(pl), pl, 1)
    h1 > h2 and l1 > l2 ? 1 : h1 < h2 and l1 < l2 ? -1 : close > h1 ? 1 : close < l1 ? -1 : 0
htfTrend = request.security(syminfo.tickerid, htf, f_trend()[1], lookahead=barmerge.lookahead_on)

// ---------- zones ----------
type Zone
    int dir
    float prox
    float dist
    int t0
    int legBar
    int baseN
    float ratio
    bool erc
    bool cont
    bool tested
    bool removed
    int remBar
    float pen
    float far
    bool back
    float gap
    bool ath
    bool leg2

var zones = array.new<Zone>()

// status of every zone, once per closed bar
if barstate.isconfirmed
    for z in zones
        if not z.removed
            h = math.abs(z.prox - z.dist)
            if z.dir > 0
                if close < z.dist or (low < z.dist and rng(0) <= emoATR * atr)
                    z.removed := true
                    z.remBar := bar_index
                else if low <= z.prox and bar_index > z.legBar + 1
                    z.tested := true
                    z.back := true
                    z.pen := math.max(z.pen, (z.prox - low) / h)
                if not z.back
                    z.far := math.max(z.far, high)
            else
                if close > z.dist or (high > z.dist and rng(0) <= emoATR * atr)
                    z.removed := true
                    z.remBar := bar_index
                else if high >= z.prox and bar_index > z.legBar + 1
                    z.tested := true
                    z.back := true
                    z.pen := math.max(z.pen, (high - z.prox) / h)
                if not z.back
                    z.far := math.min(z.far, low)

// new zone: bar[1] = move away, bars[2..] = base, bar[0] = stay-away candle
if barstate.isconfirmed and bar_index > 20
    lr = rng(1)
    d = cdir(1)
    if lr > 0 and not basing(1) and d != 0
        k = 0
        mb = 0.0
        for j = 2 to maxBase + 1
            if basing(j)
                k += 1
                mb := math.max(mb, rng(j))
            else
                break
        if k > 0 and mb > 0 and lr / mb >= legRatio
            px = d > 0 ? -1e10 : 1e10
            ds = d > 0 ? 1e10 : -1e10
            for j = 2 to k + 1
                if d > 0
                    px := math.max(px, math.max(open[j], close[j]))
                    ds := math.min(ds, low[j])
                else
                    px := math.min(px, math.min(open[j], close[j]))
                    ds := math.max(ds, high[j])
            ds := d > 0 ? math.min(ds, low[1]) : math.max(ds, high[1])
            h = math.abs(px - ds)
            stay = d > 0 ? low > px : high < px
            if h > 0 and h <= maxZoneATR * atr[1] and stay
                ercOk = bod(1) / lr >= 0.6 and (d > 0 ? (close[1] - low[1]) / lr >= 0.8 : (high[1] - close[1]) / lr >= 0.8)
                zones.push(Zone.new(d, px, ds, bar_index - k - 1, bar_index - 1, k, lr / mb, ercOk, cdir(k + 2) == d, false, false, na, 0.0, d > 0 ? math.max(high, high[1]) : math.min(low, low[1]), false, (d > 0 ? low - px : px - high) / h, d > 0 ? math.max(high, high[1]) > allHi[2] : math.min(low, low[1]) < allLo[2], not basing(0) and cdir(0) == d and rng(0) >= mb * legRatio))
                if zones.size() > 200
                    zones.shift()

dep(Zone z) => math.abs(z.far - z.prox) / math.max(math.abs(z.prox - z.dist), syminfo.mintick)
grade(Zone z) =>
    dp = dep(z)
    z.ratio >= 2.5 and z.baseN <= 3 and z.erc and dp >= 2 ? "A" : z.ratio >= 1.8 and dp >= 1.5 ? "B" : "C"
zname(Zone z) =>
    z.cont ? (z.dir > 0 ? "Rally Base Rally Demand (CP)" : "Drop Base Drop Supply (CP)") : (z.dir > 0 ? "Drop Base Rally Demand (VP)" : "Rally Base Drop Supply (VP)")
usable(Zone z) => not z.removed and z.pen < 0.5 and dep(z) >= minDep and z.legBar >= bar_index - lookback
// Sunday rule: zones should be similar in size; about half the usual size is too small
medH() =>
    hs = array.new<float>()
    for o in zones
        if not o.removed
            hs.push(math.abs(o.prox - o.dist))
    hs.size() >= 4 ? hs.median() : 0.0

// ---------- swings (traps, trendlines) ----------
var plP = array.new<float>()
var plB = array.new<int>()
var plS = array.new<bool>()
var phP = array.new<float>()
var phB = array.new<int>()
var phS = array.new<bool>()
pl = ta.pivotlow(swingN, swingN)
ph = ta.pivothigh(swingN, swingN)
if not na(pl)
    plP.push(pl), plB.push(bar_index - swingN), plS.push(false)
    if plP.size() > 60
        plP.shift(), plB.shift(), plS.shift()
if not na(ph)
    phP.push(ph), phB.push(bar_index - swingN), phS.push(false)
    if phP.size() > 60
        phP.shift(), phB.shift(), phS.shift()
if plP.size() > 0
    for i = 0 to plP.size() - 1
        if not plS.get(i) and bar_index > plB.get(i) + swingN and low < plP.get(i)
            plS.set(i, true)
if phP.size() > 0
    for i = 0 to phP.size() - 1
        if not phS.get(i) and bar_index > phB.get(i) + swingN and high > phP.get(i)
            phS.set(i, true)

// liquidity trap: an obvious, unswept swing level just in front of the zone (lesson 16); returns index or -1
trapFor(Zone z) =>
    int best = -1
    if z.dir > 0 and plP.size() > 0
        for i = plP.size() - 1 to 0
            p = plP.get(i)
            if plB.get(i) > z.legBar and not plS.get(i) and p > z.prox and p - z.prox <= trapATR * atr
                best := i
                break
    else if z.dir < 0 and phP.size() > 0
        for i = phP.size() - 1 to 0
            p = phP.get(i)
            if phB.get(i) > z.legBar and not phS.get(i) and p < z.prox and z.prox - p <= trapATR * atr
                best := i
                break
    best

// alerts: price reaches a fresh zone that agrees with the HTF trend
if doAlerts and barstate.isconfirmed and zones.size() > 0
    for z in zones
        if not z.removed and z.tested and z.pen < 0.5 and dep(z) >= minDep and z.dir == htfTrend and (z.dir > 0 ? low <= z.prox and low[1] > z.prox : high >= z.prox and high[1] < z.prox)
            alert(syminfo.ticker + " " + timeframe.period + ": price at fresh " + (z.dir > 0 ? "demand " : "supply ") + str.tostring(z.prox, format.mintick) + " (" + zname(z) + ", grade " + grade(z) + ")", alert.freq_once_per_bar_close)

// ---------- potential trades: same scoring as the RamanFX Planner / MT4 bot ----------
[htfHi, htfLo, htfAtr] = request.security(syminfo.tickerid, htf, [ta.highest(high, 100)[1], ta.lowest(low, 100)[1], ta.atr(14)[1]], lookahead=barmerge.lookahead_on)

// stop, target and R:R for a zone (mentor: CP beyond distal, VP beyond the whole valley/peak; target = nearer of swing and opposing zone)
planFor(Zone z) =>
    float ext = z.dist
    if not z.cont
        legX = z.dir > 0 ? high[bar_index - z.legBar] : low[bar_index - z.legBar]
        for b = math.max(z.legBar - 2, 0) to math.max(z.legBar - 150, 0)
            off = bar_index - b
            if off > 1990
                break
            ext := z.dir > 0 ? math.min(ext, low[off]) : math.max(ext, high[off])
            if b < z.legBar - z.baseN and (z.dir > 0 ? high[off] >= legX : low[off] <= legX)
                break
    sl = ext - z.dir * bufPips * pip * (metalOil ? metalStop : 1.0)
    float sw = na
    for off = 1 to math.max(1, math.min(bar_index - z.legBar, 1990))
        sw := na(sw) ? (z.dir > 0 ? high[off] : low[off]) : (z.dir > 0 ? math.max(sw, high[off]) : math.min(sw, low[off]))
    float opp = na
    for o in zones
        if usable(o) and o.dir != z.dir and (z.dir > 0 ? o.prox > z.prox : o.prox < z.prox)
            opp := na(opp) ? o.prox : (z.dir > 0 ? math.min(opp, o.prox) : math.max(opp, o.prox))
    tp = na(sw) ? opp : na(opp) ? sw : (z.dir > 0 ? math.min(sw, opp) : math.max(sw, opp))
    risk = math.abs(z.prox - sl)
    rr = na(tp) or risk <= 0 ? 0.0 : z.dir * (tp - z.prox) / risk
    [sl, tp, rr]

// trendlines (filled on the last bar): removals feed the chain rule, the newest intact line feeds the channel 50% check
var tlRemDir = array.new<int>()
var tlRemBar = array.new<int>()
var bool upOn = false
var bool dnOn = false
var float upP = na
var float upS = na
var float upW = na
var int upB = na
var float dnP = na
var float dnS = na
var float dnW = na
var int dnB = na
// Kevin's lines on the series of the calling context (the higher timeframes, through request.security), last bar only.
// Same rules as MT4 Trendlines() and as this chart's lines further down:
//  real valley = swing low (N bars each side) followed by a higher high above the last swing high before it breaks;
//  real peak = swing high followed by a lower low the same way. Every real pivot gets a candidate line; its anchor
//  tries 1) the extreme of the window before the pivot, 2) the previous real pivot, 3) the previous line's anchor -
//  the first that cuts no candle (anchor moves to the cutting candle, 0.05 ATR slack), is not flat (>= 0.015 ATR per bar
//  and >= 1.5 ATR in all) and is confirmed (a new high / low beyond everything between the pivots before a full candle
//  breaks it). The same anchor as the previous line = the same line, updated. Plus the overall line from the window's
//  very bottom / top while it is respected.
// Drawn (newest first, at most min(H, 3)): the newest line, the overall line while respected, older broken lines only
// from an earlier separate leg (their pivot older than the newest line's anchor).
// Returns [channel line: anchor time, anchor price, pivot time, pivot price, channel width,
//          then 3 x (anchor time, anchor price, pivot time, pivot price, end time, end price, broken 1 / 0)] (na = none).
kLine(int d, int N, int Lmax, int H, int durMs) =>
    a14 = ta.atr(14)
    float rt1 = na
    float rp1 = na
    float rt2 = na
    float rp2 = na
    float rw = na
    float l0t1 = na
    float l0p1 = na
    float l0t2 = na
    float l0p2 = na
    float l0te = na
    float l0pe = na
    float l0bk = na
    float l1t1 = na
    float l1p1 = na
    float l1t2 = na
    float l1p2 = na
    float l1te = na
    float l1pe = na
    float l1bk = na
    float l2t1 = na
    float l2p1 = na
    float l2t2 = na
    float l2p2 = na
    float l2te = na
    float l2pe = na
    float l2bk = na
    L = math.min(Lmax, bar_index - 2 * N - 20, 1990 - N)
    if barstate.islast and L > 30
        tol = 0.05 * a14[1]
        rB = array.new<int>()
        rP = array.new<float>()
        int fH = na
        int fL = na
        for off = L to N + 1
            bool isLo = true
            bool isHi = true
            for k = 1 to N
                if low[off] > low[off + k] or low[off] >= low[off - k]
                    isLo := false
                if high[off] < high[off + k] or high[off] <= high[off - k]
                    isHi := false
            if d > 0 and isLo and not na(fH)
                for o2 = off - 1 to 1
                    if low[o2] < low[off]
                        break
                    if high[o2] > high[fH]
                        rB.push(off), rP.push(low[off])
                        break
            if d < 0 and isHi and not na(fL)
                for o2 = off - 1 to 1
                    if high[o2] > high[off]
                        break
                    if low[o2] < low[fL]
                        rB.push(off), rP.push(high[off])
                        break
            if isLo
                fL := off
            if isHi
                fH := off
        // candidate lines (offsets: bigger = older); value at offset o = p2 + sl * (b2 - o); cR = break offset or -1;
        // cC = false for the overall line
        cA = array.new<int>()
        cB = array.new<int>()
        cP = array.new<float>()
        cS = array.new<float>()
        cR = array.new<int>()
        cC = array.new<bool>()
        int prevB = na
        float prevP = na
        for pass = 0 to 1
            n = pass == 0 ? rB.size() : 1
            if n > 0
                for k = 0 to n - 1
                    int b2 = na
                    float p2 = na
                    int A1 = na
                    int A3 = na
                    int A2 = na
                    if pass == 0
                        b2 := rB.get(k)
                        p2 := rP.get(k)
                        if not na(prevB) and (d > 0 ? prevP < p2 : prevP > p2)
                            A1 := prevB
                        // the previous line's anchor (MT4 lastA)
                        if cA.size() > 0
                            la0 = cA.get(cA.size() - 1)
                            if la0 > b2 and (d > 0 ? low[la0] < p2 : high[la0] > p2)
                                A3 := la0
                        float ex = na
                        if b2 + 1 <= L
                            for o3 = b2 + 1 to L
                                v = d > 0 ? low[o3] : high[o3]
                                if na(ex) or (d > 0 ? v < ex : v > ex)
                                    ex := v
                                    A2 := o3
                        if not na(ex) and (d > 0 ? ex >= p2 : ex <= p2)
                            A2 := na
                        prevB := b2
                        prevP := p2
                    else
                        // overall: very bottom / top of the window to the real pivot keeping every other one on its side
                        float ov = na
                        for o3 = 1 to L
                            v = d > 0 ? low[o3] : high[o3]
                            if na(ov) or (d > 0 ? v < ov : v > ov)
                                ov := v
                                A2 := o3
                        float bs = na
                        if rB.size() > 0
                            for k2 = 0 to rB.size() - 1
                                o4 = rB.get(k2)
                                if o4 < A2 - 1
                                    s0 = (rP.get(k2) - ov) / (A2 - o4)
                                    if (d > 0 ? s0 > 0 : s0 < 0) and (na(bs) or (d > 0 ? s0 < bs : s0 > bs))
                                        bs := s0
                                        b2 := o4
                                        p2 := rP.get(k2)
                        if na(b2)
                            A2 := na
                    // 1) window extreme, 2) previous real pivot, 3) previous line's anchor: the first with a real angle wins
                    int fa = na
                    float fsl = na
                    for tryI = 0 to 2
                        A = tryI == 0 ? A2 : tryI == 1 ? A1 : A3
                        if na(A) or not na(fa)
                            continue
                        int a = A
                        float sl = 0.0
                        for it = 0 to 49
                            sl := (p2 - (d > 0 ? low[a] : high[a])) / (a - b2)
                            int worst = -1
                            float exc = tol
                            if a - 1 >= b2 + 1
                                for o5 = a - 1 to b2 + 1
                                    lv = p2 + sl * (b2 - o5)
                                    e = d > 0 ? lv - low[o5] : high[o5] - lv
                                    if e > exc
                                        exc := e
                                        worst := o5
                            if worst < 0
                                break
                            a := worst
                        sl := (p2 - (d > 0 ? low[a] : high[a])) / (a - b2)
                        if math.abs(sl) >= 0.015 * a14[b2] and math.abs(sl * (a - b2)) >= 1.5 * a14[b2]
                            fa := a
                            fsl := sl
                    // confirmed only after a new high / low beyond everything between the pivots, before the line breaks
                    if not na(fa) and fa - 1 >= b2 + 1 and b2 - 1 >= 1
                        float ext = na
                        for o8 = fa - 1 to b2 + 1
                            ext := na(ext) ? (d > 0 ? high[o8] : low[o8]) : (d > 0 ? math.max(ext, high[o8]) : math.min(ext, low[o8]))
                        bool cfm = false
                        for o9 = b2 - 1 to 1
                            lv = p2 + fsl * (b2 - o9)
                            if d > 0 ? high[o9] < lv : low[o9] > lv
                                break
                            if d > 0 ? high[o9] > ext : low[o9] < ext
                                cfm := true
                                break
                        if not cfm
                            fa := na
                    else
                        fa := na
                    if not na(fa)
                        int rem = -1
                        for o6 = b2 - 1 to 1
                            lv = p2 + fsl * (b2 - o6)
                            if d > 0 ? high[o6] < lv : low[o6] > lv
                                rem := o6
                                break
                        // the overall line: not when it repeats a line's anchor or pivot, and only while respected
                        bool dup = false
                        if pass == 1 and cA.size() > 0
                            for q2 = 0 to cA.size() - 1
                                if cA.get(q2) == fa or cB.get(q2) == b2
                                    dup := true
                        if not (pass == 1 and (dup or rem >= 0))
                            // the same anchor as the previous line = the same trendline, updated (never two lines from one anchor)
                            if pass == 0 and cA.size() > 0 and cA.get(cA.size() - 1) == fa
                                cA.pop(), cB.pop(), cP.pop(), cS.pop(), cR.pop(), cC.pop()
                            cA.push(fa), cB.push(b2), cP.push(p2), cS.push(fsl), cR.push(rem), cC.push(pass == 0)
        if cA.size() > 0
            // the newest line = the latest second pivot (overall line excluded)
            int nw = -1
            for q = 0 to cA.size() - 1
                if cC.get(q) and (nw < 0 or cB.get(q) < cB.get(nw))
                    nw := q
            int nwA = -1
            if nw >= 0
                nwA := cA.get(nw)
            // channel / trade checks: the newest line while respected, else the overall line while respected
            int use = -1
            if nw >= 0 and cR.get(nw) < 0
                use := nw
            if use < 0
                for q = 0 to cA.size() - 1
                    if not cC.get(q) and cR.get(q) < 0
                        use := q
            if use >= 0
                ua = cA.get(use)
                ub = cB.get(use)
                up2 = cP.get(use)
                us = cS.get(use)
                float w = 0.0
                for o7 = ua to 1
                    lv = up2 + us * (ub - o7)
                    w := math.max(w, d > 0 ? high[o7] - lv : lv - low[o7])
                rt1 := time[ua]
                rp1 := up2 + us * (ub - ua)
                rt2 := time[ub]
                rp2 := up2
                rw := w
            int shown = 0
            for q = cA.size() - 1 to 0
                keep = q == nw or (not cC.get(q) and cR.get(q) < 0) or (cR.get(q) >= 0 and nw >= 0 and cB.get(q) > nwA)
                if keep and shown < math.min(H, 3)
                    qa = cA.get(q)
                    qb = cB.get(q)
                    qp = cP.get(q)
                    qs = cS.get(q)
                    qr = cR.get(q)
                    float vt1 = time[qa]
                    float vp1 = qp + qs * (qb - qa)
                    float vt2 = time[qb]
                    float vp2 = qp
                    float vte = qr >= 0 ? time[qr] : time + 3 * durMs
                    float vpe = qr >= 0 ? qp + qs * (qb - qr) : qp + qs * (qb + 3)
                    float vbk = qr >= 0 ? 1.0 : 0.0
                    if shown == 0
                        l0t1 := vt1
                        l0p1 := vp1
                        l0t2 := vt2
                        l0p2 := vp2
                        l0te := vte
                        l0pe := vpe
                        l0bk := vbk
                    else if shown == 1
                        l1t1 := vt1
                        l1p1 := vp1
                        l1t2 := vt2
                        l1p2 := vp2
                        l1te := vte
                        l1pe := vpe
                        l1bk := vbk
                    else
                        l2t1 := vt1
                        l2p1 := vp1
                        l2t2 := vt2
                        l2p2 := vp2
                        l2te := vte
                        l2pe := vpe
                        l2bk := vbk
                    shown += 1
    [rt1, rp1, rt2, rp2, rw, l0t1, l0p1, l0t2, l0p2, l0te, l0pe, l0bk, l1t1, l1p1, l1t2, l1p2, l1te, l1pe, l1bk, l2t1, l2p1, l2t2, l2p2, l2te, l2pe, l2bk]

// the timeframes above this chart for multi-timeframe trendlines (MT4 StepUp / InpHTFLevels = 4): 15m -> 1H, 4H, D, W
stepUp(int n) =>
    s0 = timeframe.in_seconds()
    i = (s0 <= 60 ? 0 : s0 <= 300 ? 1 : s0 <= 1800 ? 2 : s0 <= 3600 ? 3 : s0 <= 14400 ? 4 : s0 <= 86400 ? 5 : s0 <= 604800 ? 6 : 7) + n
    i == 1 ? "5" : i == 2 ? "15" : i == 3 ? "60" : i == 4 ? "240" : i == 5 ? "D" : i == 6 ? "W" : i == 7 ? "M" : ""
tfL1 = stepUp(1)
tfL2 = stepUp(2)
tfL3 = stepUp(3)
tfL4 = stepUp(4)
// a level that is missing, not above this chart or the same as the HTF (requested anyway) gets length 0: no work, no lines
tfR1 = tfL1 == "" ? timeframe.period : tfL1
tfR2 = tfL2 == "" ? timeframe.period : tfL2
tfR3 = tfL3 == "" ? timeframe.period : tfL3
tfR4 = tfL4 == "" ? timeframe.period : tfL4
kSec0 = timeframe.in_seconds(htf)
kSec1 = timeframe.in_seconds(tfR1)
kSec2 = timeframe.in_seconds(tfR2)
kSec3 = timeframe.in_seconds(tfR3)
kSec4 = timeframe.in_seconds(tfR4)
kLen1 = tfL1 == "" or kSec1 <= tfs or kSec1 == kSec0 ? 0 : lookback
kLen2 = tfL2 == "" or kSec2 <= tfs or kSec2 == kSec0 ? 0 : lookback
kLen3 = tfL3 == "" or kSec3 <= tfs or kSec3 == kSec0 ? 0 : lookback
kLen4 = tfL4 == "" or kSec4 <= tfs or kSec4 == kSec0 ? 0 : lookback
[hu1, hup1, hu2, hup2, huw, k0u0t1, k0u0p1, k0u0t2, k0u0p2, k0u0te, k0u0pe, k0u0bk, k0u1t1, k0u1p1, k0u1t2, k0u1p2, k0u1te, k0u1pe, k0u1bk, k0u2t1, k0u2p1, k0u2t2, k0u2p2, k0u2te, k0u2pe, k0u2bk] = request.security(syminfo.tickerid, htf, kLine(1, tlSwing, lookback, tlHist, kSec0 * 1000), lookahead=barmerge.lookahead_off)
[hd1, hdp1, hd2, hdp2, hdw, k0d0t1, k0d0p1, k0d0t2, k0d0p2, k0d0te, k0d0pe, k0d0bk, k0d1t1, k0d1p1, k0d1t2, k0d1p2, k0d1te, k0d1pe, k0d1bk, k0d2t1, k0d2p1, k0d2t2, k0d2p2, k0d2te, k0d2pe, k0d2bk] = request.security(syminfo.tickerid, htf, kLine(-1, tlSwing, lookback, tlHist, kSec0 * 1000), lookahead=barmerge.lookahead_off)
[k1uc1, k1uc2, k1uc3, k1uc4, k1uw, k1u0t1, k1u0p1, k1u0t2, k1u0p2, k1u0te, k1u0pe, k1u0bk, k1u1t1, k1u1p1, k1u1t2, k1u1p2, k1u1te, k1u1pe, k1u1bk, k1u2t1, k1u2p1, k1u2t2, k1u2p2, k1u2te, k1u2pe, k1u2bk] = request.security(syminfo.tickerid, tfR1, kLine(1, tlSwing, kLen1, tlHist, kSec1 * 1000), lookahead=barmerge.lookahead_off)
[k1dc1, k1dc2, k1dc3, k1dc4, k1dw, k1d0t1, k1d0p1, k1d0t2, k1d0p2, k1d0te, k1d0pe, k1d0bk, k1d1t1, k1d1p1, k1d1t2, k1d1p2, k1d1te, k1d1pe, k1d1bk, k1d2t1, k1d2p1, k1d2t2, k1d2p2, k1d2te, k1d2pe, k1d2bk] = request.security(syminfo.tickerid, tfR1, kLine(-1, tlSwing, kLen1, tlHist, kSec1 * 1000), lookahead=barmerge.lookahead_off)
[k2uc1, k2uc2, k2uc3, k2uc4, k2uw, k2u0t1, k2u0p1, k2u0t2, k2u0p2, k2u0te, k2u0pe, k2u0bk, k2u1t1, k2u1p1, k2u1t2, k2u1p2, k2u1te, k2u1pe, k2u1bk, k2u2t1, k2u2p1, k2u2t2, k2u2p2, k2u2te, k2u2pe, k2u2bk] = request.security(syminfo.tickerid, tfR2, kLine(1, tlSwing, kLen2, tlHist, kSec2 * 1000), lookahead=barmerge.lookahead_off)
[k2dc1, k2dc2, k2dc3, k2dc4, k2dw, k2d0t1, k2d0p1, k2d0t2, k2d0p2, k2d0te, k2d0pe, k2d0bk, k2d1t1, k2d1p1, k2d1t2, k2d1p2, k2d1te, k2d1pe, k2d1bk, k2d2t1, k2d2p1, k2d2t2, k2d2p2, k2d2te, k2d2pe, k2d2bk] = request.security(syminfo.tickerid, tfR2, kLine(-1, tlSwing, kLen2, tlHist, kSec2 * 1000), lookahead=barmerge.lookahead_off)
[k3uc1, k3uc2, k3uc3, k3uc4, k3uw, k3u0t1, k3u0p1, k3u0t2, k3u0p2, k3u0te, k3u0pe, k3u0bk, k3u1t1, k3u1p1, k3u1t2, k3u1p2, k3u1te, k3u1pe, k3u1bk, k3u2t1, k3u2p1, k3u2t2, k3u2p2, k3u2te, k3u2pe, k3u2bk] = request.security(syminfo.tickerid, tfR3, kLine(1, tlSwing, kLen3, tlHist, kSec3 * 1000), lookahead=barmerge.lookahead_off)
[k3dc1, k3dc2, k3dc3, k3dc4, k3dw, k3d0t1, k3d0p1, k3d0t2, k3d0p2, k3d0te, k3d0pe, k3d0bk, k3d1t1, k3d1p1, k3d1t2, k3d1p2, k3d1te, k3d1pe, k3d1bk, k3d2t1, k3d2p1, k3d2t2, k3d2p2, k3d2te, k3d2pe, k3d2bk] = request.security(syminfo.tickerid, tfR3, kLine(-1, tlSwing, kLen3, tlHist, kSec3 * 1000), lookahead=barmerge.lookahead_off)
[k4uc1, k4uc2, k4uc3, k4uc4, k4uw, k4u0t1, k4u0p1, k4u0t2, k4u0p2, k4u0te, k4u0pe, k4u0bk, k4u1t1, k4u1p1, k4u1t2, k4u1p2, k4u1te, k4u1pe, k4u1bk, k4u2t1, k4u2p1, k4u2t2, k4u2p2, k4u2te, k4u2pe, k4u2bk] = request.security(syminfo.tickerid, tfR4, kLine(1, tlSwing, kLen4, tlHist, kSec4 * 1000), lookahead=barmerge.lookahead_off)
[k4dc1, k4dc2, k4dc3, k4dc4, k4dw, k4d0t1, k4d0p1, k4d0t2, k4d0p2, k4d0te, k4d0pe, k4d0bk, k4d1t1, k4d1p1, k4d1t2, k4d1p2, k4d1te, k4d1pe, k4d1bk, k4d2t1, k4d2p1, k4d2t2, k4d2p2, k4d2te, k4d2pe, k4d2bk] = request.security(syminfo.tickerid, tfR4, kLine(-1, tlSwing, kLen4, tlHist, kSec4 * 1000), lookahead=barmerge.lookahead_off)
// HTF line on this chart, refined the way you do it going down the timeframes (MT4 RefineOnChart + ChartBarIn):
//  1) anchor = this chart's candle holding the extreme inside the HTF anchor bar;
//  2) touch = the candle up to the HTF pivot that keeps every candle between on the right side (no cut candles);
//  3) walk forward: a later swing poking beyond the line becomes the new touch; stop at the first full candle beyond it
//     on this chart (the break here) and, for a line already broken on the HTF, at the HTF break bar.
// na anchor when this chart's history (1990 bars) does not reach back to the HTF anchor bar.
// Returns [anchor bar, anchor price, touch bar, touch price, slope, break bar or na, chart bar of the HTF break or na].
refineTL(int d, float t1, float t2, float te, int durMs, int N) =>
    int ca = na
    float va = na
    int phb = na
    float vp = na
    int eb = na
    bool full = false
    if not na(t1) and not na(t2)
        for off = 0 to math.min(bar_index - 1, 1990 - N)
            tt = time[off]
            if tt <= t1
                full := true
            if tt < t1
                break
            if not na(te) and tt >= te
                eb := bar_index - off
            v = d > 0 ? low[off] : high[off]
            if tt < t1 + durMs and (na(va) or (d > 0 ? v < va : v > va))
                va := v
                ca := bar_index - off
            if tt >= t2 and tt < t2 + durMs and (na(vp) or (d > 0 ? v < vp : v > vp))
                vp := v
                phb := bar_index - off
    int cb = na
    float vb = na
    float sl = na
    int ce = na
    if full and not na(ca) and not na(phb) and phb > ca
        for x = ca + 1 to phb
            v = d > 0 ? low[bar_index - x] : high[bar_index - x]
            s0 = (v - va) / (x - ca)
            if (d > 0 ? s0 > 0 : s0 < 0) and (na(sl) or (d > 0 ? s0 < sl : s0 > sl))
                sl := s0
                cb := x
                vb := v
        stopX = na(eb) ? bar_index - 1 : math.min(bar_index - 1, eb + 1)
        if not na(cb) and phb + 1 <= bar_index - 1
            for x = phb + 1 to bar_index - 1
                off = bar_index - x
                lv = vb + sl * (x - cb)
                if d > 0 ? high[off] < lv : low[off] > lv
                    ce := x
                    break
                if x > stopX
                    break
                if off > N
                    bool piv = true
                    for k = 1 to N
                        if d > 0 ? (low[off] > low[off + k] or low[off] >= low[off - k]) : (high[off] < high[off + k] or high[off] <= high[off - k])
                            piv := false
                    v = d > 0 ? low[off] : high[off]
                    if piv and (d > 0 ? v < lv : v > lv)
                        s0 = (v - va) / (x - ca)
                        if d > 0 ? s0 > 0 : s0 < 0
                            sl := s0
                            cb := x
                            vb := v
    [na(cb) or not full ? na : ca, va, cb, vb, sl, ce, eb]

hLineAt(float t1, float p1, float t2, float p2, float t) => na(t1) or t2 == t1 ? na : p2 + (p2 - p1) / (t2 - t1) * (t - t2)

overext(int d, float price) =>
    hv = d > 0 ? hLineAt(hu1, hup1, hu2, hup2, time) : hLineAt(hd1, hdp1, hd2, hdp2, time)
    hw = d > 0 ? huw : hdw
    hx = not na(hv) and not na(hw) and (d > 0 ? price > hv + hw / 2 : price < hv - hw / 2)
    hx or (d > 0 ? (upOn and price > upP + upS * (bar_index - upB) + upW / 2) : (dnOn and price < dnP + dnS * (bar_index - dnB) - dnW / 2))
// +1: price reaches the zone without crossing a respected trendline (the line sits beyond it, protecting it);
// -1: a respected line lies between price and the zone; 0: no line
crossNeeded(int d, float prox) =>
    cv = d > 0 ? (upOn ? upP + upS * (bar_index - upB) : na) : (dnOn ? dnP + dnS * (bar_index - dnB) : na)
    hv = d > 0 ? hLineAt(hu1, hup1, hu2, hup2, time) : hLineAt(hd1, hdp1, hd2, hdp2, time)
    int res = 0
    for v in array.from(cv, hv)
        if not na(v)
            if d < 0
                if v > close and v < prox
                    res := -1
                    break
                if v >= prox
                    res := 1
            else
                if v < close and v > prox
                    res := -1
                    break
                if v <= prox
                    res := 1
    res
// zone within 1 ATR of a respected trendline in its direction: "" or the timeframe name
nearTL(int d, float price) =>
    cv = d > 0 ? (upOn ? upP + upS * (bar_index - upB) : na) : (dnOn ? dnP + dnS * (bar_index - dnB) : na)
    hv = d > 0 ? hLineAt(hu1, hup1, hu2, hup2, time) : hLineAt(hd1, hdp1, hd2, hdp2, time)
    not na(cv) and math.abs(price - cv) <= atr ? timeframe.period : not na(hv) and math.abs(price - hv) <= atr ? htf : ""

qualified(Zone z) =>
    bool q = false
    for o in zones
        if o.dir != z.dir and o.removed and not na(o.remBar) and o.remBar >= z.t0 and o.remBar <= z.legBar + 5
            q := true
            break
    if not q and tlRemDir.size() > 0
        for i = 0 to tlRemDir.size() - 1
            if tlRemDir.get(i) == -z.dir and tlRemBar.get(i) >= z.t0 and tlRemBar.get(i) <= z.legBar + 5
                q := true
                break
    q or z.ath

// Arrival zone (strongest): the move away broke a trendline AND took out the previous swing high / low,
// an opposing zone or an all-time high / low
arrival(Zone z) =>
    bool tl = false
    if tlRemDir.size() > 0
        for i = 0 to tlRemDir.size() - 1
            if tlRemDir.get(i) == -z.dir and tlRemBar.get(i) >= z.t0 and tlRemBar.get(i) <= z.legBar + 5
                tl := true
                break
    bool other = z.ath
    if tl and not other
        for o in zones
            if o.dir != z.dir and o.removed and not na(o.remBar) and o.remBar >= z.t0 and o.remBar <= z.legBar + 5
                other := true
                break
    if tl and not other
        if z.dir > 0 and phP.size() > 0
            for i = phP.size() - 1 to 0
                if phB.get(i) < z.t0
                    other := z.far > phP.get(i)
                    break
        if z.dir < 0 and plP.size() > 0
            for i = plP.size() - 1 to 0
                if plB.get(i) < z.t0
                    other := z.far < plP.get(i)
                    break
    tl and other

// Planner points (0-100) + Seiden / mentor odds checklist
scoreZone(Zone z, float sl) =>
    risk = math.abs(z.prox - sl)
    dp = dep(z)
    q = qualified(z)
    depth = htfHi > htfLo ? (z.dir > 0 ? (z.prox - htfLo) / (htfHi - htfLo) * 100 : (htfHi - z.prox) / (htfHi - htfLo) * 100) : 50.0
    bool nearOpp = false
    for o in zones
        if usable(o) and o.dir != z.dir and z.dir * (o.prox - z.prox) > 0 and z.dir * (o.prox - z.prox) < 1.5 * risk
            nearOpp := true
    trap = trapFor(z) >= 0
    aplus = z.erc and z.ratio >= 2.5
    sc = (aplus ? 24 : 14) + (z.baseN <= 3 ? 14 : z.baseN <= 6 ? 4 : 0) + (z.baseN == 1 ? 2 : 0) + (q ? 10 : 0) + (not z.tested ? 8 : 0) + (bar_index - z.legBar <= 100 ? 4 : 0)
    sc += (htfTrend == z.dir ? 14 : htfTrend == 0 ? 5 : 0) + (nearOpp ? 0 : 6) + math.round(math.max(0, math.min(1, (100 - depth) / 100)) * 6) + (trap ? 3 : 0) + (z.cont ? 0 : 4) + (dp >= 2 ? 3 : 0)
    sc += (z.gap >= 0.5 ? 4 : z.gap >= 0.25 ? 2 : 0) + (z.leg2 ? 3 : 0) + (z.ath ? 3 : 0)
    ok = "✔ ", no = "✘ "
    why = (aplus ? ok + "Strength: A+ move away (" : no + "Strength: decent move away (") + str.tostring(z.ratio, "#.0") + "x base)"
    why += "\n" + (z.baseN <= 3 ? ok : no) + "Time at level: " + str.tostring(z.baseN) + " base candle" + (z.baseN > 1 ? "s" : "")
    why += "\n" + (not z.tested ? ok + "Freshness: untouched" : no + "Freshness: tested " + str.tostring(math.round(z.pen * 100)) + "% deep")
    why += "\n" + (dp >= 2 ? ok : no) + "Departure: left " + str.tostring(dp, "#.0") + "x zone height"
    why += "\n" + (q ? ok + "Chain: " + (z.ath ? "made a new all-time " + (z.dir > 0 ? "high" : "low") : "removed an opposing zone") : no + "Chain: removed nothing (check if it broke your trendline)")
    why += "\n" + (z.gap >= 0.25 ? ok : no) + "Stay-away space: " + str.tostring(math.round(z.gap * 100)) + "% of zone" + (z.gap < minGap ? " (drawable only)" : "")
    why += "\n" + (z.leg2 ? ok + "Second explosive candle in the move away" : no + "Only one explosive candle")
    why += "\n" + (htfTrend == z.dir ? ok + "Trend: with the " + htf + " trend" : htfTrend == 0 ? no + "Trend: " + htf + " unclear" : no + "Trend: AGAINST the " + htf + " trend")
    why += "\n" + (depth <= 50 ? ok : no) + "Curve: " + (z.dir > 0 ? "low" : "high") + " in the " + htf + " curve at " + str.tostring(math.round(depth)) + "% " + (depth <= 33 ? "(best third)" : depth <= 50 ? "(good half)" : "(expensive side)")
    why += "\n" + (nearOpp ? no + "Profit margin: opposing zone close in front" : ok + "Profit margin: clear path to target")
    why += "\n" + (trap ? ok + "Liquidity trap in front (stops to be taken first)" : no + "No liquidity trap in front")
    why += "\n" + (z.cont ? no + "Type: CP continuation (VP preferred)" : ok + "Type: VP valley/peak (mentor's favourite)")
    [math.min(100, sc), why]

// one-line explanation shown under each note in the tooltip
noteHelp(string n) =>
    string h = ""
    if h == "" and str.contains(n, "clear space")
        h := " (stay-away candle stayed this % of the zone height away: price left fast, orders still there. <15% = drawable only)"
    if h == "" and str.contains(n, "drawable only")
        h := " (stay-away candle came back too close: real zone, not tradable)"
    if h == "" and str.contains(n, "explosive move away")
        h := " (move-away candle vs biggest base candle. 2.5x+ strong)"
    if h == "" and str.contains(n, "weak move away")
        h := " (move away barely bigger than the base)"
    if h == "" and str.contains(n, "2nd explosive candle")
        h := " (a second big push followed)"
    if h == "" and str.contains(n, "only one explosive candle")
        h := " (the push stopped after one candle)"
    if h == "" and str.contains(n, "base candle")
        h := " (short time at level = more orders left)"
    if h == "" and str.contains(n, "long base")
        h := " (long time at level = orders used up)"
    if h == "" and str.contains(n, "not in the chain")
        h := " (removed nothing: Kevin skips it)"
    if h == "" and str.contains(n, "in the chain")
        h := " (removed a zone / trendline or made a new high-low)"
    if h == "" and str.contains(n, "ARRIVAL")
        h := " (broke the trendline AND the previous high-low: strongest)"
    if h == "" and str.contains(n, "fresh")
        h := " (price has not come back yet)"
    if h == "" and str.contains(n, "already tested")
        h := " (price came back: orders partly used)"
    if h == "" and str.contains(n, "VP")
        h := " (reversal zone (valley / peak): Kevin's favourite)"
    if h == "" and str.contains(n, "with the")
        h := " (same way as the HTF trend)"
    if h == "" and str.contains(n, "against the")
        h := " (fights the HTF trend)"
    if h == "" and str.contains(n, "beyond channel 50%")
        h := " (overextended half of the channel: wait)"
    if h == "" and str.contains(n, "too small")
        h := " (much smaller than other zones: easily run through)"
    if h == "" and str.contains(n, "without crossing")
        h := " (no trendline between price and the zone)"
    if h == "" and str.contains(n, "must cross")
        h := " (a trendline must break first)"
    if h == "" and str.contains(n, "at the")
        h := " (sits on a respected trendline)"
    if h == "" and str.contains(n, "liquidity trap")
        h := " (obvious high-low in front: stops get taken first)"
    if h == "" and str.contains(n, "far:")
        h := " (more than 2x HTF ATR away: not soon)"
    if h == "" and str.contains(n, "obvious S/R")
        h := " (level everyone sees: crowded)"
    h
// Strong / weak in a few words (Kevin + Seiden checks). WEAK = any deal-breaker; STRONG = 5+ strengths, at most one weakness
zoneNotes(Zone z, float medZ) =>
    zPl = array.new<string>()
    zMi = array.new<string>()
    zCr = array.new<string>()
    if z.baseN <= 3
        zPl.push(str.tostring(z.baseN) + " base candle" + (z.baseN > 1 ? "s" : ""))
    else if z.baseN > 6
        zMi.push("long base (" + str.tostring(z.baseN) + " candles)")
    if z.ratio >= 2.5
        zPl.push("explosive move away " + str.tostring(z.ratio, "#.0") + "x")
    else if z.ratio < 1.8
        zMi.push("weak move away " + str.tostring(z.ratio, "#.0") + "x")
    if z.leg2
        zPl.push("2nd explosive candle")
    else
        zMi.push("only one explosive candle")
    isArr = arrival(z)
    if isArr
        zPl.push("ARRIVAL zone: broke the trendline AND took out the previous high / low or a zone")
    if qualified(z)
        zPl.push(z.ath ? "in the chain: new " + (z.dir > 0 ? "high" : "low") : "in the chain: removed a zone / trendline")
    else
        zCr.push("not in the chain (removed nothing)")
    if z.gap < minGap
        zCr.push("drawable only: no space under the stay-away candle")
    else if z.gap >= 0.25
        zPl.push("clear space " + str.tostring(math.round(z.gap * 100)) + "%")
    if z.tested
        zCr.push("already tested")
    else
        zPl.push("fresh")
    if medZ > 0 and math.abs(z.prox - z.dist) < minSizeMed * medZ
        zCr.push("too small vs other zones")
    if not z.cont
        zPl.push("VP (Kevin's favourite)")
    if htfTrend == z.dir
        zPl.push("with the " + htf + " trend")
    else if htfTrend == -z.dir
        zCr.push("against the " + htf + " trend")
    if overext(z.dir, z.prox)
        zCr.push("beyond channel 50% (overextended)")
    cxn = crossNeeded(z.dir, z.prox)
    if cxn > 0
        zPl.push("price reaches it without crossing a trendline")
    else if cxn < 0
        zMi.push("price must cross a trendline to reach it")
    ntl = nearTL(z.dir, z.prox)
    if ntl != ""
        zPl.push("at the " + ntl + " trendline")
    if trapFor(z) >= 0
        zPl.push("liquidity trap in front")
    xa = na(htfAtr) or htfAtr <= 0 ? 0.0 : math.abs(close - z.prox) / htfAtr
    if xa > liveATR
        zMi.push("far: " + str.tostring(xa, "#.0") + " x " + htf + " ATR")
    verdict = zCr.size() > 0 ? "WEAK" : (zPl.size() >= 5 and zMi.size() <= 1) or isArr ? "STRONG" : "OK"
    shortWhy = zCr.size() > 0 ? zCr.get(0) + (zCr.size() > 1 ? ", " + zCr.get(1) : "") : verdict == "STRONG" ? zPl.get(0) + (zPl.size() > 1 ? ", " + zPl.get(1) : "") : zMi.size() > 0 ? zMi.get(0) : zPl.size() > 0 ? zPl.get(0) : ""
    // the plan the drills taught: entry at the proximal, stop past the distal + buffer, target before the next zone
    [psl, ptp, prr] = planFor(z)
    [psc, pwhy] = scoreZone(z, psl)
    pg = zCr.size() > 0 ? "C" : psc >= 75 ? "A" : psc >= 60 ? "B" : "C"
    pno = zCr.size() > 0 ? zCr.get(0) : na(ptp) ? "no opposing zone for a target" : prr < minRR ? "R:R 1:" + str.tostring(prr, "#.0") + " below 1:" + str.tostring(minRR, "#.0") : ""
    full = "Grade " + pg + " (" + str.tostring(psc) + ") | " + verdict + " | Trade: " + (pno == "" ? "YES" : "NO - " + pno)
    if not na(ptp)
        full += "\nPlan: " + (z.dir > 0 ? "buy limit " : "sell limit ") + str.tostring(z.prox, format.mintick) + "  SL " + str.tostring(psl, format.mintick) + "  TP " + str.tostring(ptp, format.mintick) + "  = 1:" + str.tostring(prr, "#.0")
    if z.gap >= minGap
        full += "\nClear space " + str.tostring(math.round(z.gap * 100)) + "%: price left fast, orders still waiting (want 25%+, best 50%+)"
    lsn = (metalOil ? "wider stop on gold/oil (drill 10); " : "") + (z.tested ? "tested = skip (drill 10); " : "") + (overext(z.dir, z.prox) ? "overextended = wait (drill 9); " : "") + "TP before the next zone, not past it (drills 2, 6, 7)"
    for t in zCr
        full += "\n✘ " + t
    for t in zMi
        full += "\n– " + t
    for t in zPl
        if not str.startswith(t, "clear space")
            full += "\n✔ " + t
    full += "\nDrills: " + lsn
    [verdict, shortWhy, full]

gradeOf(int sc) => sc >= 75 ? "A" : sc >= 60 ? "B" : "C"
gradeOk(string g) => gradeF == "All" or (gradeF == "A only" and g == "A") or (gradeF == "A + B" and g != "C") or (gradeF == "B only" and g == "B") or (gradeF == "C only" and g == "C")
var string lastBest = ""

// ---------- drawing (last bar only) ----------
visRange = ta.highest(high, 150) - ta.lowest(low, 150)
var boxes = array.new<box>()
var lines = array.new<line>()
var labels = array.new<label>()
var table panel = table.new(panelWhere, 1, 40, bgcolor=color.new(#000000, 70), frame_color=color.new(#C9CED8, 80), frame_width=1, border_width=0)

if barstate.islast
    for b in boxes
        b.delete()
    for l in lines
        l.delete()
    for lb in labels
        lb.delete()
    boxes.clear(), lines.clear(), labels.clear()
    right = bar_index + 25
    // every price tag goes through these arrays; close ones are merged into one readable label at the end
    tagP = array.new<float>()
    tagT = array.new<string>()
    tagC = array.new<color>()
    tagTip = array.new<string>()

    // ---- trendlines, Kevin's way (same rules and display as MT4 Trendlines / DedupeTL): a REAL valley is a swing low
    // after which price makes a higher high (above the last swing high) before breaking the valley; a REAL peak is a swing
    // high followed by a lower low. Lines anchored so no candle is cut, drawn until a full candle closes beyond them
    zL = math.max(tlSwing + 1, math.min(lookback, bar_index - 20, 1990 - tlSwing))
    pvB = array.new<int>()
    pvP = array.new<float>()
    pvT = array.new<int>()
    int fH = na
    int fL = na
    for off = zL to tlSwing + 1
        bool isLo = true
        bool isHi = true
        for k = 1 to tlSwing
            if low[off] > low[off + k] or low[off] >= low[off - k]
                isLo := false
            if high[off] < high[off + k] or high[off] <= high[off - k]
                isHi := false
        bi = bar_index - off
        if isLo and not na(fH)
            pk = high[bar_index - fH]
            for o2 = off - 1 to 1
                if low[o2] < low[off]
                    break
                if high[o2] > pk
                    pvB.push(bi), pvP.push(low[off]), pvT.push(-1)
                    break
        if isHi and not na(fL)
            vl = low[bar_index - fL]
            for o2 = off - 1 to 1
                if high[o2] > high[off]
                    break
                if low[o2] < vl
                    pvB.push(bi), pvP.push(high[off]), pvT.push(1)
                    break
        if isLo
            fL := bi
        if isHi
            fH := bi
    upOn := false
    dnOn := false
    tlRemDir.clear()
    tlRemBar.clear()
    string tlNote = ""
    // every drawn trendline (this chart's and the HTF ones), for one line per pivot pair (MT4 RegTL / DedupeTL):
    // anchor time, touch time, direction, broken, rank (0 = this chart, else the timeframe in minutes), line,
    // price now and 30 bars ago, timeframe name ("" = this chart), still drawn
    rgA = array.new<float>()
    rgB = array.new<float>()
    rgD = array.new<int>()
    rgX = array.new<bool>()
    rgR = array.new<int>()
    rgL = array.new<line>()
    rgV0 = array.new<float>()
    rgV1 = array.new<float>()
    rgTf = array.new<string>()
    rgOn = array.new<bool>()
    for kd = 0 to 1
        d = kd == 0 ? 1 : -1
        want = d > 0 ? -1 : 1
        // every real valley (peak) gets a candidate line; the anchor tries 1) the lowest (highest) point before it,
        // 2) the previous real one, 3) the previous line's anchor - the first that is not near-flat (Kevin: that is
        // momentum, not a trendline) and is confirmed. Plus the overall line from the very bottom (top) while respected.
        // cC = false for the overall line; cR = bar where a full candle closed beyond it (-1 = respected)
        cA = array.new<int>()
        cB = array.new<int>()
        cP = array.new<float>()
        cS = array.new<float>()
        cR = array.new<int>()
        cC = array.new<bool>()
        tol = 0.05 * atr[1]
        int prevB = na
        float prevP = na
        for pass = 0 to 1
            cnt = pass == 0 ? pvB.size() : 1
            if cnt > 0
                for k = 0 to cnt - 1
                    int b2 = na
                    float p2 = na
                    int A1 = na
                    int A3 = na
                    int A2 = na
                    if pass == 0
                        if pvT.get(k) != want
                            continue
                        b2 := pvB.get(k)
                        p2 := pvP.get(k)
                        if not na(prevB) and (d > 0 ? prevP < p2 : prevP > p2)
                            A1 := prevB
                        // the original starting point of the current line (MT4 lastA)
                        if cA.size() > 0
                            la0 = cA.get(cA.size() - 1)
                            if la0 < b2 and (d > 0 ? low[bar_index - la0] < p2 : high[bar_index - la0] > p2)
                                A3 := la0
                        float ex = na
                        if bar_index - zL <= b2 - 1
                            for x = bar_index - zL to b2 - 1
                                v = d > 0 ? low[bar_index - x] : high[bar_index - x]
                                if na(ex) or (d > 0 ? v < ex : v > ex)
                                    ex := v
                                    A2 := x
                        if not na(ex) and (d > 0 ? ex >= p2 : ex <= p2)
                            A2 := na
                        prevB := b2
                        prevP := p2
                    else
                        // overall line from the very bottom / top of the window
                        float ov = na
                        for x = bar_index - zL to bar_index - 1
                            v = d > 0 ? low[bar_index - x] : high[bar_index - x]
                            if na(ov) or (d > 0 ? v < ov : v > ov)
                                ov := v
                                A2 := x
                        float bs = na
                        if pvB.size() > 0
                            for k2 = 0 to pvB.size() - 1
                                if pvT.get(k2) == want and pvB.get(k2) > A2 + 1
                                    s0 = (pvP.get(k2) - ov) / (pvB.get(k2) - A2)
                                    if (d > 0 ? s0 > 0 : s0 < 0) and (na(bs) or (d > 0 ? s0 < bs : s0 > bs))
                                        bs := s0
                                        b2 := pvB.get(k2)
                                        p2 := pvP.get(k2)
                        if na(b2)
                            A2 := na
                    // 1) lowest / highest point, 2) previous real pivot, 3) previous line's anchor; first with a real angle
                    int fa = na
                    float fsl = na
                    for tryI = 0 to 2
                        A = tryI == 0 ? A2 : tryI == 1 ? A1 : A3
                        if na(A) or not na(fa)
                            continue
                        int a = A
                        float sl = 0.0
                        for it = 0 to 49
                            sl := (p2 - (d > 0 ? low[bar_index - a] : high[bar_index - a])) / (b2 - a)
                            int worst = -1
                            float exc = tol
                            if b2 - 1 >= a + 1
                                for x = a + 1 to b2 - 1
                                    lv = p2 + sl * (x - b2)
                                    e = d > 0 ? lv - low[bar_index - x] : high[bar_index - x] - lv
                                    if e > exc
                                        exc := e
                                        worst := x
                            if worst < 0
                                break
                            a := worst
                        sl := (p2 - (d > 0 ? low[bar_index - a] : high[bar_index - a])) / (b2 - a)
                        atrB = atr[bar_index - b2]
                        if math.abs(sl) >= 0.015 * atrB and math.abs(sl * (b2 - a)) >= 1.5 * atrB
                            fa := a
                            fsl := sl
                    // confirmed only when price makes a new high above everything between the two valleys (new low
                    // below everything between the two peaks) before a full candle breaks the line
                    bool cfm = false
                    if not na(fa) and b2 - 1 >= fa + 1 and bar_index - 1 >= b2 + 1
                        float ext = na
                        for x = fa + 1 to b2 - 1
                            ext := na(ext) ? (d > 0 ? high[bar_index - x] : low[bar_index - x]) : (d > 0 ? math.max(ext, high[bar_index - x]) : math.min(ext, low[bar_index - x]))
                        for x = b2 + 1 to bar_index - 1
                            lv = p2 + fsl * (x - b2)
                            if d > 0 ? high[bar_index - x] < lv : low[bar_index - x] > lv
                                break
                            if d > 0 ? high[bar_index - x] > ext : low[bar_index - x] < ext
                                cfm := true
                                break
                    if not na(fa) and cfm
                        int rem = -1
                        for x = b2 + 1 to bar_index - 1
                            lv = p2 + fsl * (x - b2)
                            if d > 0 ? high[bar_index - x] < lv : low[bar_index - x] > lv
                                rem := x
                                break
                        bool dup = false
                        if pass == 1 and cA.size() > 0
                            for q2 = 0 to cA.size() - 1
                                if cA.get(q2) == fa or cB.get(q2) == b2
                                    dup := true
                        if not (pass == 1 and (dup or rem >= 0))
                            // same anchor as the previous line = the same trendline, updated (never two lines from one anchor)
                            if pass == 0 and cA.size() > 0 and cA.get(cA.size() - 1) == fa
                                cA.pop(), cB.pop(), cP.pop(), cS.pop(), cR.pop(), cC.pop()
                            cA.push(fa), cB.push(b2), cP.push(p2), cS.push(fsl), cR.push(rem), cC.push(pass == 0)
        // removals of the lines that were kept feed the chain rule (MT4 reads its TL list)
        if cA.size() > 0
            for q = 0 to cA.size() - 1
                if cR.get(q) >= 0
                    tlRemDir.push(d), tlRemBar.push(cR.get(q))
        // draw (MT4): the newest line only (a refined line replaces the older ones), the overall line while respected,
        // and older broken lines only from an earlier, separate leg (pivot older than the newest line's anchor); newest
        // first, at most tlHist each way
        int use = -1
        int nw = -1
        if cA.size() > 0
            // the newest leg line is the one with the latest second pivot (the overall line does not count)
            for q = 0 to cA.size() - 1
                if cC.get(q) and (nw < 0 or cB.get(q) > cB.get(nw))
                    nw := q
            int nwA = -1
            if nw >= 0
                nwA := cA.get(nw)
            if nw >= 0 and cR.get(nw) < 0
                use := nw
            if use < 0
                for q = 0 to cA.size() - 1
                    if not cC.get(q) and cR.get(q) < 0
                        use := q
            shown = 0
            for q = cA.size() - 1 to 0
                keep = q == nw or (not cC.get(q) and cR.get(q) < 0) or (cR.get(q) >= 0 and nw >= 0 and cB.get(q) < nwA)
                if keep and shown < tlHist and showTL and (d > 0 ? showUpTL : showDnTL)
                    shown += 1
                    la = cA.get(q)
                    lb2 = cB.get(q)
                    lp2 = cP.get(q)
                    ls = cS.get(q)
                    brk = cR.get(q) >= 0
                    x2 = brk ? cR.get(q) : bar_index + 3
                    // respected: thin solid; broken: thin dotted, lighter, ending where it broke
                    ln0 = line.new(la, lp2 + ls * (la - lb2), x2, lp2 + ls * (x2 - lb2), color=brk ? color.new(cTL, 60) : cTL, style=brk ? line.style_dotted : line.style_solid, width=1)
                    lines.push(ln0)
                    rgA.push(time[bar_index - la]), rgB.push(time[bar_index - lb2]), rgD.push(d), rgX.push(brk), rgR.push(0), rgL.push(ln0)
                    rgV0.push(lp2 + ls * (bar_index - lb2)), rgV1.push(lp2 + ls * (bar_index - 30 - lb2)), rgTf.push(""), rgOn.push(true)
        // channel 50% from the newest respected line: drives the overextended check; the helper line only if asked
        if use >= 0
            la = cA.get(use)
            lb2 = cB.get(use)
            lp2 = cP.get(use)
            ls = cS.get(use)
            float w = 0.0
            for x = la to bar_index - 1
                lv = lp2 + ls * (x - lb2)
                w := math.max(w, d > 0 ? high[bar_index - x] - lv : lv - low[bar_index - x])
            if showChan and showTL
                lines.push(line.new(la, lp2 + ls * (la - lb2) + d * w / 2, bar_index + 3, lp2 + ls * (bar_index + 3 - lb2) + d * w / 2, color=color.new(cTL, 70), style=line.style_dotted))
            if d > 0
                upOn := true
                upP := lp2
                upS := ls
                upB := lb2
                upW := w
            else
                dnOn := true
                dnP := lp2
                dnS := ls
                dnB := lb2
                dnW := w
            tlNote := tlNote + (tlNote == "" ? "" : " | ") + (d > 0 ? "Up trendline: " : "Down trendline: ") + (overext(d, close) ? "price beyond the channel 50% = OVEREXTENDED, wait" : "price in the golden area")
    // ---- higher-timeframe lines on this chart (MT4 InpHTFLevels = 4: e.g. 15m -> 1H, 4H, D, W; plus the HTF if it is
    // not one of them): per timeframe and direction the same selection as above (at most min(tlHist, 3)), re-anchored
    // on this chart's candles. Respected = thin dotted gold; broken = lighter gold dotted, ending where it broke.
    // layout of tlH: (((slot * 2 + up 0 / down 1) * 3 + line) * 7 + field), slot 0 = HTF, 1..4 = the levels above
    tlH = array.new<float>()
    tlH.concat(array.from(k0u0t1, k0u0p1, k0u0t2, k0u0p2, k0u0te, k0u0pe, k0u0bk, k0u1t1, k0u1p1, k0u1t2, k0u1p2, k0u1te, k0u1pe, k0u1bk, k0u2t1, k0u2p1, k0u2t2, k0u2p2, k0u2te, k0u2pe, k0u2bk))
    tlH.concat(array.from(k0d0t1, k0d0p1, k0d0t2, k0d0p2, k0d0te, k0d0pe, k0d0bk, k0d1t1, k0d1p1, k0d1t2, k0d1p2, k0d1te, k0d1pe, k0d1bk, k0d2t1, k0d2p1, k0d2t2, k0d2p2, k0d2te, k0d2pe, k0d2bk))
    tlH.concat(array.from(k1u0t1, k1u0p1, k1u0t2, k1u0p2, k1u0te, k1u0pe, k1u0bk, k1u1t1, k1u1p1, k1u1t2, k1u1p2, k1u1te, k1u1pe, k1u1bk, k1u2t1, k1u2p1, k1u2t2, k1u2p2, k1u2te, k1u2pe, k1u2bk))
    tlH.concat(array.from(k1d0t1, k1d0p1, k1d0t2, k1d0p2, k1d0te, k1d0pe, k1d0bk, k1d1t1, k1d1p1, k1d1t2, k1d1p2, k1d1te, k1d1pe, k1d1bk, k1d2t1, k1d2p1, k1d2t2, k1d2p2, k1d2te, k1d2pe, k1d2bk))
    tlH.concat(array.from(k2u0t1, k2u0p1, k2u0t2, k2u0p2, k2u0te, k2u0pe, k2u0bk, k2u1t1, k2u1p1, k2u1t2, k2u1p2, k2u1te, k2u1pe, k2u1bk, k2u2t1, k2u2p1, k2u2t2, k2u2p2, k2u2te, k2u2pe, k2u2bk))
    tlH.concat(array.from(k2d0t1, k2d0p1, k2d0t2, k2d0p2, k2d0te, k2d0pe, k2d0bk, k2d1t1, k2d1p1, k2d1t2, k2d1p2, k2d1te, k2d1pe, k2d1bk, k2d2t1, k2d2p1, k2d2t2, k2d2p2, k2d2te, k2d2pe, k2d2bk))
    tlH.concat(array.from(k3u0t1, k3u0p1, k3u0t2, k3u0p2, k3u0te, k3u0pe, k3u0bk, k3u1t1, k3u1p1, k3u1t2, k3u1p2, k3u1te, k3u1pe, k3u1bk, k3u2t1, k3u2p1, k3u2t2, k3u2p2, k3u2te, k3u2pe, k3u2bk))
    tlH.concat(array.from(k3d0t1, k3d0p1, k3d0t2, k3d0p2, k3d0te, k3d0pe, k3d0bk, k3d1t1, k3d1p1, k3d1t2, k3d1p2, k3d1te, k3d1pe, k3d1bk, k3d2t1, k3d2p1, k3d2t2, k3d2p2, k3d2te, k3d2pe, k3d2bk))
    tlH.concat(array.from(k4u0t1, k4u0p1, k4u0t2, k4u0p2, k4u0te, k4u0pe, k4u0bk, k4u1t1, k4u1p1, k4u1t2, k4u1p2, k4u1te, k4u1pe, k4u1bk, k4u2t1, k4u2p1, k4u2t2, k4u2p2, k4u2te, k4u2pe, k4u2bk))
    tlH.concat(array.from(k4d0t1, k4d0p1, k4d0t2, k4d0p2, k4d0te, k4d0pe, k4d0bk, k4d1t1, k4d1p1, k4d1t2, k4d1p2, k4d1te, k4d1pe, k4d1bk, k4d2t1, k4d2p1, k4d2t2, k4d2p2, k4d2te, k4d2pe, k4d2bk))
    if showTL and showHtfTL
        for s = 4 to 0
            secN = s == 0 ? kSec0 : s == 1 ? kSec1 : s == 2 ? kSec2 : s == 3 ? kSec3 : kSec4
            lenN = s == 0 ? (kSec0 > tfs ? 1 : 0) : s == 1 ? kLen1 : s == 2 ? kLen2 : s == 3 ? kLen3 : kLen4
            tfN = s == 0 ? htf : s == 1 ? tfL1 : s == 2 ? tfL2 : s == 3 ? tfL3 : tfL4
            if lenN > 0
                for kd = 0 to 1
                    d = kd == 0 ? 1 : -1
                    if d > 0 ? showUpTL : showDnTL
                        for j = 0 to 2
                            bs0 = ((s * 2 + kd) * 3 + j) * 7
                            ht1 = tlH.get(bs0)
                            if not na(ht1)
                                hp1 = tlH.get(bs0 + 1)
                                ht2 = tlH.get(bs0 + 2)
                                hte = tlH.get(bs0 + 4)
                                hpe = tlH.get(bs0 + 5)
                                hbk = tlH.get(bs0 + 6) > 0
                                colH = hbk ? color.new(cHtfTL, 55) : cHtfTL
                                bool done = false
                                if refineHtf
                                    [ra, rpa, rb, rpb, rsl, rce, reb] = refineTL(d, ht1, ht2, hbk ? hte : na, secN * 1000, tlSwing)
                                    int xe = na(rce) ? (hbk ? reb : na) : rce
                                    if not na(ra) and not (hbk and na(xe))
                                        rx2 = na(xe) ? bar_index + 3 : xe
                                        lnR = line.new(ra, rpa, rx2, rpb + rsl * (rx2 - rb), color=colH, style=line.style_dotted, width=1)
                                        lines.push(lnR)
                                        rgA.push(time[bar_index - ra]), rgB.push(time[bar_index - rb]), rgD.push(d), rgX.push(hbk), rgR.push(int(secN / 60)), rgL.push(lnR)
                                        rgV0.push(rpb + rsl * (bar_index - rb)), rgV1.push(rpb + rsl * (bar_index - 30 - rb)), rgTf.push(tfN), rgOn.push(true)
                                        done := true
                                if not done
                                    // this chart's history does not reach the anchor (or refining is off): the HTF coordinates
                                    lnH = line.new(int(ht1), hp1, int(hte), hpe, xloc=xloc.bar_time, color=colH, style=line.style_dotted, width=1)
                                    lines.push(lnH)
                                    rgA.push(ht1), rgB.push(ht2), rgD.push(d), rgX.push(hbk), rgR.push(int(secN / 60)), rgL.push(lnH)
                                    rgV0.push(hLineAt(ht1, hp1, hte, hpe, time)), rgV1.push(hLineAt(ht1, hp1, hte, hpe, time[30])), rgTf.push(tfN), rgOn.push(true)
    // one line per pivot pair (MT4 DedupeTL): the same anchor candle and the same touch candle (within 3 bars of this
    // chart), or two respected lines lying on top of each other (within 0.3 ATR now and 30 bars ago), are one trendline:
    // keep the respected one, then the higher timeframe's
    rgN = rgL.size()
    if rgN > 1
        dNear = 3 * tfs * 1000
        dTol = 0.3 * atr[1]
        for dI = 0 to rgN - 2
            for dJ = dI + 1 to rgN - 1
                if rgD.get(dI) == rgD.get(dJ) and rgOn.get(dI) and rgOn.get(dJ)
                    samePiv = math.abs(rgA.get(dI) - rgA.get(dJ)) <= dNear and math.abs(rgB.get(dI) - rgB.get(dJ)) <= dNear
                    onTop = not rgX.get(dI) and not rgX.get(dJ) and math.abs(rgV0.get(dI) - rgV0.get(dJ)) <= dTol and math.abs(rgV1.get(dI) - rgV1.get(dJ)) <= dTol
                    if samePiv or onTop
                        dS1 = (rgX.get(dI) ? 0 : 10000000) + rgR.get(dI)
                        dS2 = (rgX.get(dJ) ? 0 : 10000000) + rgR.get(dJ)
                        dDel = dS1 >= dS2 ? dJ : dI
                        line.delete(rgL.get(dDel))
                        rgOn.set(dDel, false)
    // the "H4 trendline" tag for every respected HTF line still drawn
    if rgN > 0
        for dI = 0 to rgN - 1
            if rgOn.get(dI) and not rgX.get(dI) and rgTf.get(dI) != "" and not na(rgV0.get(dI))
                tfT = rgTf.get(dI)
                tagP.push(rgV0.get(dI)), tagT.push(tfT + " trendline"), tagC.push(cHtfTL), tagTip.push(tfT + (rgD.get(dI) > 0 ? " uptrend line (a higher high followed its valley)" : " downtrend line (a lower low followed its peak)") + ". Zones near it are stronger.")

    // potential trades: every fresh usable zone with a valid plan, ranked by planner score
    tIdx = array.new<int>()
    tSc = array.new<float>()
    tSl = array.new<float>()
    tTp = array.new<float>()
    tRr = array.new<float>()
    tWhy = array.new<string>()
    medZ = medH()
    string none = htfTrend == 0 ? "HTF trend unclear - wait" : "no fresh zone with R:R >= " + str.tostring(minRR, "#.0")
    if showPlan and zones.size() > 0
        for i = 0 to zones.size() - 1
            z = zones.get(i)
            if not usable(z) or z.pen > 0.25
                continue
            if onlyChain and not qualified(z)
                continue
            if z.gap < minGap or z.dir == 0
                continue
            if overext(z.dir, z.prox)
                continue
            if medZ > 0 and math.abs(z.prox - z.dist) < minSizeMed * medZ
                continue
            if not showCounter and htfTrend != 0 and z.dir != htfTrend
                continue
            if z.dir > 0 ? close <= z.prox : close >= z.prox
                continue
            if maxDist > 0 and not na(htfAtr) and math.abs(close - z.prox) > maxDist * htfAtr
                continue
            [sl, tp, rr] = planFor(z)
            if rr < minRR
                continue
            [sc, why] = scoreZone(z, sl)
            if not gradeOk(gradeOf(sc))
                continue
            tIdx.push(i), tSc.push(sc + 10.0 * (1 - math.min(1, math.abs(close - z.prox) / (3 * atr)))), tSl.push(sl), tTp.push(tp), tRr.push(rr), tWhy.push(why)
    rank = tSc.sort_indices(order.descending)
    nList = math.min(nTrades, tIdx.size())
    rows = array.new<string>()
    tradeOf = array.new<int>(zones.size(), 0)          // zone index -> trade rank (1 = best), 0 = none
    tradeTxt = array.new<string>(zones.size(), "")
    tpDone = array.new<float>()
    string bestWhy = ""
    string bestKey = ""
    var float hwProx = na
    var float hwHalf = na
    var bool hwHit = false
    if nList > 0
        for n = 0 to nList - 1
            j = rank.get(n)
            z = zones.get(tIdx.get(j))
            sl = tSl.get(j), tp = tTp.get(j), rr = tRr.get(j)
            [sc, why] = scoreZone(z, sl)
            g = gradeOf(sc)
            side = z.dir > 0 ? "BUY" : "SELL"
            ctr = htfTrend != 0 and z.dir != htfTrend
            tradeOf.set(tIdx.get(j), n + 1)
            tradeTxt.set(tIdx.get(j), "trade #" + str.tostring(n + 1) + " " + g + " " + str.tostring(sc))
            xatr = na(htfAtr) or htfAtr <= 0 ? 0.0 : math.abs(close - z.prox) / htfAtr
            isFar = xatr > liveATR
            if n == 0
                if isFar
                    if na(hwProx) or hwProx != z.prox
                        hwProx := z.prox
                        hwHalf := (close + z.prox) / 2
                        hwHit := false
                    lines.push(line.new(bar_index, hwHalf, right, hwHalf, color=color.new(#E8C46A, 20), style=line.style_dotted))
                    tagP.push(hwHalf), tagT.push("halfway alert"), tagC.push(#E8C46A), tagTip.push("Zone is " + str.tostring(xatr, "#.0") + " x " + htf + " ATR away. Price needs about " + str.tostring(math.ceil(xatr)) + " " + htf + " candles one way to reach it and often turns first. Plan it; when price reaches this halfway line, look for a new lower-timeframe zone in the chain.")
                    if not hwHit and (z.dir < 0 ? high >= hwHalf : low <= hwHalf)
                        hwHit := true
                        alert(syminfo.ticker + " " + timeframe.period + ": halfway to the " + (z.dir > 0 ? "demand " : "supply ") + str.tostring(z.prox, format.mintick) + " - check for a lower-timeframe zone in the chain", alert.freq_once_per_bar)
                else
                    hwProx := na
            whyX = why + "\n" + (isFar ? "✘ Distance: " + str.tostring(xatr, "#.0") + " x " + htf + " ATR - FAR, planned only (halfway alert " + str.tostring(hwHalf, format.mintick) + ")" : "✔ Distance: " + str.tostring(xatr, "#.0") + " x " + htf + " ATR - within reach")
            rows.push("#" + str.tostring(n + 1) + " " + side + " limit " + str.tostring(z.prox, format.mintick) + "  SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick) + "  1:" + str.tostring(rr, "#.0") + "  " + g + " " + str.tostring(sc) + (z.cont ? " CP" : " VP") + (g == "C" ? "  half risk" : "") + (ctr ? "  COUNTER-TREND" : "") + "  " + str.tostring(xatr, "#.0") + "xATR" + (isFar ? " FAR" : ""))
            if n == 0
                bestWhy := whyX
                bestKey := side + str.tostring(z.prox, format.mintick)
            if n == 0 or planLines == "All listed"
                x1 = bar_index + 2, x2 = right
                lines.push(line.new(x1, z.prox, x2, z.prox, color=cEntry, width=n == 0 ? 2 : 1))
                lines.push(line.new(x1, sl, x2, sl, color=cStop, style=line.style_dashed))
                lines.push(line.new(x1, tp, x2, tp, color=cTgt, style=line.style_dashed))
                // one label per trade (all numbers in it) so nothing stacks on the zone price tags
                tagP.push(z.prox), tagT.push("#" + str.tostring(n + 1) + " " + side + " " + str.tostring(z.prox, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | 1:" + str.tostring(rr, "#.0") + " | " + g), tagC.push(cEntry), tagTip.push(whyX)
                if not tpDone.includes(tp)
                    tpDone.push(tp)
                    tagP.push(tp), tagT.push("TP " + str.tostring(tp, format.mintick)), tagC.push(cTgt), tagTip.push("Target of trade #" + str.tostring(n + 1))
    if doAlerts and bestKey != "" and bestKey != lastBest
        alert(syminfo.ticker + " " + timeframe.period + " potential trade: " + rows.get(0), alert.freq_once_per_bar)
    lastBest := bestKey


    // the N zones closest to price
    idx = array.new<int>()
    dst = array.new<float>()
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            z = zones.get(i)
            if usable(z) and (showTested or not z.tested)
                idx.push(i)
                dst.push(math.abs(close - z.prox))
    ord = dst.sort_indices()
    shown = math.min(nShow, idx.size())
    if shown > 0
        for n = 0 to shown - 1
            z = zones.get(idx.get(ord.get(n)))
            g = grade(z)
            tr = showTrap ? trapFor(z) : -1
            zi = idx.get(ord.get(n))
            isTrade = tradeOf.get(zi) > 0
            [verdict, shortWhy, full] = zoneNotes(z, medZ)
            txt = showNames ? (str.contains(full, "ARRIVAL") ? "ARRIVAL | " : "") + zname(z) + " | " + verdict + (shortWhy != "" ? ": " + shortWhy : "") + (isTrade ? " | " + tradeTxt.get(zi) : "") : ""
            boxes.push(box.new(z.t0, z.prox, right, z.dist, border_color=z.dir > 0 ? cDemL : cSupL, border_width=str.contains(full, "ARRIVAL") ? 3 : 1, bgcolor=z.dir > 0 ? cDemF : cSupF, text=txt, text_color=verdict == "WEAK" ? color.new(cTxt, 45) : cTxt, text_size=size.small, text_halign=text.align_left, text_valign=z.dir > 0 ? text.align_bottom : text.align_top))
            labels.push(label.new(right, (z.prox + z.dist) / 2, "ⓘ", style=label.style_label_left, color=color.new(z.dir > 0 ? cDemL : cSupL, 20), textcolor=color.white, size=size.small, tooltip=zname(z) + " | " + verdict + "\n" + full))
            if not (isTrade and (planLines == "All listed" or tradeOf.get(zi) == 1))
                tagP.push(z.prox), tagT.push(str.tostring(z.prox, format.mintick)), tagC.push(z.dir > 0 ? cDemL : cSupL), tagTip.push(zname(z) + " - " + full)
                tagP.push(z.dist), tagT.push(str.tostring(z.dist, format.mintick)), tagC.push(cTxt), tagTip.push("Distal line (far side) of the zone")
            if tr >= 0
                tp = z.dir > 0 ? plP.get(tr) : phP.get(tr)
                tb = z.dir > 0 ? plB.get(tr) : phB.get(tr)
                lines.push(line.new(tb, tp, right, tp, color=cTrap, width=3))

    // removed zones, faint
    if showRemoved and zones.size() > 0
        cnt = 0
        for i = zones.size() - 1 to 0
            z = zones.get(i)
            if z.removed and cnt < 6 and z.legBar >= bar_index - lookback
                boxes.push(box.new(z.t0, z.prox, z.remBar, z.dist, border_color=cRem, bgcolor=cRem))
                cnt += 1

    // merge price tags that would sit on top of each other
    if tagP.size() > 0
        gap = visRange * labelGap / 100
        so = tagP.sort_indices()
        float cp = tagP.get(so.get(0))
        string ct = tagT.get(so.get(0))
        color cc = tagC.get(so.get(0))
        string ctip = tagTip.get(so.get(0))
        for k = 1 to tagP.size()
            bool flush = k == tagP.size()
            if not flush
                j = so.get(k)
                if tagP.get(j) - cp < gap
                    if not str.contains(ct, tagT.get(j))
                        ct := str.startswith(tagT.get(j), "#") ? tagT.get(j) + "  /  " + ct : ct + "  /  " + tagT.get(j)
                    cc := str.startswith(tagT.get(j), "#") ? tagC.get(j) : cc
                    ctip := ctip + "\n" + tagTip.get(j)
                else
                    flush := true
            if flush
                labels.push(label.new(right, cp, ct, style=label.style_label_left, color=color.new(#000000, 45), textcolor=cc, size=size.small, tooltip=ctip))
                if k < tagP.size()
                    j = so.get(k)
                    cp := tagP.get(j), ct := tagT.get(j), cc := tagC.get(j), ctip := tagTip.get(j)

    if showPanel
        panel.clear(0, 0, 0, 39)
        r = 0
        table.cell(panel, 0, r, "ZoneVision  " + timeframe.period + " -> " + htf, text_color=cEntry, text_size=panelSize, text_halign=text.align_left)
        r += 1
        table.cell(panel, 0, r, "Bias: " + (htfTrend > 0 ? "UP (HTF higher highs / lows)" : htfTrend < 0 ? "DOWN (HTF lower highs / lows)" : "unclear - wait"), text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
        r += 1
        if panelView != "Header only"
            table.cell(panel, 0, r, "Zones: " + str.tostring(idx.size()) + " fresh/usable, " + str.tostring(shown) + " drawn", text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
            r += 1
            if panelView == "Full"
                table.cell(panel, 0, r, "Key: VP = valley/peak (reversal) · CP = continuation · clear space = gap under the stay-away candle · ATR = average candle size · HTF = higher timeframe · ✘ deal-breaker · – weakness · ✔ strength", text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
                r += 1
            if tlNote != ""
                table.cell(panel, 0, r, tlNote, text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
                r += 1
            if panelView == "Full"
                table.cell(panel, 0, r, (metalOil ? "Gold/oil: wider stop (x" + str.tostring(metalStop, "#.0") + "). " : "") + (tfs <= 3600 ? "Intraday: no limit orders into red-folder news" : "Swing TF: news filter not needed"), text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
                r += 1
        if showPlan and panelView != "Header only"
            table.cell(panel, 0, r, rows.size() == 0 ? "Potential trades: none (" + none + ")" : "Potential trades, best first (entry | stop | target | R:R | grade):", text_color=cEntry, text_size=panelSize, text_halign=text.align_left)
            r += 1
            for t in rows
                table.cell(panel, 0, r, t, text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
                r += 1
            if showWhy and panelView == "Full" and bestWhy != ""
                table.cell(panel, 0, r, "Why #1 (Seiden odds + mentor rules) - hover the #1 label for this too:", text_color=cEntry, text_size=panelSize, text_halign=text.align_left)
                r += 1
                for ln in str.split(bestWhy, "\n")
                    table.cell(panel, 0, r, ln, text_color=str.startswith(ln, "✔") ? cTgt : cStop, text_size=panelSize, text_halign=text.align_left)
                    r += 1
                table.cell(panel, 0, r, "Manage: +1R stop to -0.5R, +2R break-even, trail under new zones", text_color=cTxt, text_size=panelSize, text_halign=text.align_left)
